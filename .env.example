EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase migration (see supabase/migrations, src/services/supabaseClient.js)
# — Project Settings -> API in the Supabase dashboard. The anon key is safe
# to ship client-side; it's constrained by the RLS policies in the migration.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Numeric Telegram user id — ProfileScreen only renders the admin broadcast
# card when the signed-in user's telegramId matches this. Not a secret by
# itself (client-side gate only); broadcast-notification's own
# ADMIN_TELEGRAM_ID Supabase secret is what actually authorizes a send.
EXPO_PUBLIC_ADMIN_TELEGRAM_ID=your_numeric_telegram_id_here

# The bot's public @username (no @, e.g. "shoom_bot") — ProfileScreen's
# "Пригласить друга" row builds the referral link as
# t.me/<this>?start=ref_<telegramId>. Public info (anyone can see it by
# opening the bot in Telegram), safe client-side.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username_here
