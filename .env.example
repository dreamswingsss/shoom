EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase migration (see supabase/migrations, src/services/supabaseClient.js)
# — Project Settings -> API in the Supabase dashboard. The anon key is safe
# to ship client-side; it's constrained by the RLS policies in the migration.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
